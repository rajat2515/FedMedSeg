# ── Data ─────────────────────────────────────────────────────────────────────
data/raw/          # 1.2 GB chest X-ray images — DO NOT track
data/rsna_pneumonia/*.dcm
# Allow the small CSV/JSON partition files only
data/*
!data/rsna_pneumonia/
data/rsna_pneumonia/*
!data/rsna_pneumonia/subset/

# ── Model Weights (tracked via Git LFS — safe to include) ────────────────────
# *.pth files are now handled by Git LFS (see .gitattributes)
# Git LFS stores only a small pointer here; the binary lives on the LFS server

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
venv312/

# ── Results (generated outputs — keep CSVs/PNGs, skip weights) ───────────────
results/*
!results/**/
!results/**/*.csv
!results/**/*.json
!results/**/*.png
!results/**/*.pdf

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
ray_sessions/

# ── Environment Variables ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── LaTeX ─────────────────────────────────────────────────────────────────────
*.tex
*.aux
*.log
*.toc
*.pdf
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
